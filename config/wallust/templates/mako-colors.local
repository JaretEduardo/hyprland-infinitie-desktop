# generated by hypr-wallpaper (wallust) — machine-local, git-ignored.
# Pulled in by ~/.config/mako/config via `include=`. Global colour keys only;
# mako merges these over the defaults set before the include line.
background-color={{ background | darken(0.10) }}f2
text-color={{ foreground }}ff
border-color={{ color5 | saturate(0.20) }}ff
progress-color=over {{ color5 | darken(0.30) }}ff
