# mako — Wayland notification daemon for this workstation.
# man 5 mako   ·   reload after edits:   makoctl reload
#
# Colours are wallpaper-driven: `hypr-wallpaper` (wallust) regenerates
# ~/.config/mako/colors.local from config/wallust/templates/mako-colors.local,
# and the `include=` below pulls it in. The values here are the fallback used
# until that file exists (seeded by `hypr-wallpaper --seed`, which
# lua/autostart.lua runs once per fresh session). Geometry stays static.
#
# Started by config/hypr/lua/autostart.lua; also D-Bus-activatable, so a
# notification sent before that runs still brings mako up.

font=sans-serif 10
background-color=#2f2430f2
text-color=#f1e2ecff
border-color=#e6c4d8ff
include=~/.config/mako/colors.local
border-size=2
border-radius=6

width=340
height=140
margin=10
padding=12
anchor=top-right
layer=top
max-visible=5
default-timeout=6000

icons=1
max-icon-size=48
markup=1
format=<b>%s</b>\n%b

[urgency=low]
border-color=#2a2e3f

[urgency=critical]
border-color=#f7768e
default-timeout=0
