# managed by hyprland-infinitie-desktop (install.sh gpu)
#
# RTD3: put the NVIDIA GPU into runtime power management on driver bind so it
# can suspend (D3hot / D3cold, hardware permitting) when it has no clients.
#
# ONLY install this if the NVIDIA driver package does NOT already ship an
# equivalent rule. Recent x11-drivers/nvidia-drivers (and Fedora's RPM Fusion
# packaging) ship 80-nvidia-pm.rules that does exactly this — `install.sh gpu`
# checks for it and skips this file when it is present.
#
# Matches by PCI vendor+class, not by bus address, so it survives hardware
# changes. Mirrors the driver's own rule.

ACTION=="bind",   SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000", TEST=="power/control", ATTR{power/control}="auto"
ACTION=="bind",   SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030200", TEST=="power/control", ATTR{power/control}="auto"
ACTION=="unbind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000", TEST=="power/control", ATTR{power/control}="on"
ACTION=="unbind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030200", TEST=="power/control", ATTR{power/control}="on"
